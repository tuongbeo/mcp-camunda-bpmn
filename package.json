{
  "name": "mcp-camunda-bpmn",
  "version": "1.0.0",
  "description": "Remote MCP Server for Camunda 8 BPMN generation \u2014 deployed on Cloudflare Workers",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
